{
  "name": "saiassist-rsa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dealer-based Roadside Assistance (RSA) policy management platform",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/node.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "build:vercel": "vite build && node scripts/build-vercel.mjs",
    "start": "node dist/server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx server/scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
