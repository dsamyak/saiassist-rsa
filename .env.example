# Copy to .env for local overrides (all values are optional for local development).

# PostgreSQL connection string. Leave empty to use the embedded PGlite database in .data/pglite.
DATABASE_URL=

# Required in production: at least 32 random characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=

# Initial Super Admin, created on first start only.
SUPERADMIN_EMAIL=admin@saiassist.local
SUPERADMIN_PASSWORD=Admin@12345
SUPERADMIN_NAME=Platform Super Admin

# Seed two fictional demo dealers with staff, customers and ~14 months of policies (first start only).
SEED_DEMO=true
DEMO_PASSWORD=Demo@12345

# Public URL used for certificate QR codes, e.g. https://rsa.example.com (defaults to the request origin).
PUBLIC_BASE_URL=

# Optional notification gateways. Without them, notifications are logged as "not configured".
RESEND_API_KEY=
EMAIL_FROM=
SMS_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=

# Local server port
PORT=8787
